# Dockerfile.airflow (recommended)
FROM apache/airflow:2.9.0

# Use root for apt installs
USER root

# Install Java (JRE/JDK headless) and procps (ps), curl, libpq-dev
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      openjdk-17-jdk-headless \
      procps \
      curl \
      build-essential \
      libpq-dev && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Set JAVA_HOME so PySpark can find it at runtime
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="$JAVA_HOME/bin:$PATH"

# Switch back to airflow non-root user
USER ${AIRFLOW_UID:-50000}
