s/dim_customers\')\n    dim_customers.write.mode(\'overwrite\').parquet(f\'{GOLD_PATH}/dimensions/dim_customers\')\n    dim_customers.write.jdbc(url=POSTGRES_URL, table=\'dim_customers\', mode=\'overwrite\', properties=POSTGRES_PROPERTIES)\n    print(\'dim_customers loaded to Postgres\')\nexcept Exception as e:\n    print("Error in create_dim_customers:", e)\n    raise\nfinally:\n    spark.stop()\nPY']
