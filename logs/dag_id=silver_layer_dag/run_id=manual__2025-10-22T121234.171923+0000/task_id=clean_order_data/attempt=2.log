[2025-10-22T12:29:13.517+0000] {subprocess.py:75} INFO - Running command: ['/usr/bin/bash', '-c', '\necho "== Clean order data =="\npython3 - <<\'PY\'\n\nimport os\nfrom pyspark.sql import SparkSession, functions as F\nfrom pyspark.sql.types import StringType, FloatType\n\n# set credentials and local ip inside runtime process\nos.environ[\'AWS_ACCESS_KEY_ID\'] = \'minioadmin\'\nos.environ[\'AWS_SECRET_ACCESS_KEY\'] = \'minioadmin\'\nos.environ[\'SPARK_LOCAL_IP\'] = \'127.0.0.1\'\n\n# create spark session (packages used to access s3a and aws jars)\nspark = SparkSession.builder \\\n    .appName("SilverLayerProcessing") \\\n    .config("spark.hadoop.fs.s3a.endpoint", "http://minio:9000") \\\n    .config("spark.hadoop.fs.s3a.access.key", "minioadmin") \\\n    .config("spark.hadoop.fs.s3a.secret.key", "minioadmin") \\\n    .config("spark.hadoop.fs.s3a.impl", "org.apache.hadoop.fs.s3a.S3AFileSystem") \\\n    .config("spark.jars.packages", "org.apache.hadoop:hadoop-aws:3.3.4,com.amazonaws:aws-java-sdk-s3:1.12.570") \\\n    .getOrCreate()\n\nfrom minio import Minio\nclient = Minio("minio:9000", access_key="minioadmin", secret_key="minioadmin", secure=False)\n\n# ensure buckets exist (idempotent)\nfor b in ["bronze", "silver"]:\n    try:\n        if not client.bucket_exists(b):\n            client.make_bucket(b)\n    except Exception as e:\n        # keep going; bucket checks often fail if MinIO not yet fully ready — error will surface when reading\n        print("minio bucket check:", e)\n\n# define s3a paths\nBRONZE_PATH = "s3a://bronze"\nSILVER_PATH = "s3a://silver"\n\ntry:\n    df = spark.read.option("header", "true").csv(f"{BRONZE_PATH}/orders/orders.csv")\n    print("Raw orders rows:", df.count())\n\n    df_cleaned = df.dropDuplicates(["id"])         .na.drop(subset=["id", "userId"])         .withColumn("total", F.col("total").cast(FloatType()))         .filter(F.col("total").isNotNull())         .filter(F.col("total") > 0)         .withColumn("discountedTotal", F.coalesce(F.col("discountedTotal").cast(FloatType()), F.col("total")))         .withColumn("discount_percentage", F.round(((F.col("total") - F.col("discountedTotal")) / F.col("total") * 100), 2))         .withColumn("order_value_category",\n            F.when(F.col("total") < 100, "Small")\n             .when((F.col("total") >= 100) & (F.col("total") < 500), "Medium")\n             .when((F.col("total") >= 500) & (F.col("total") < 1000), "Large")\n             .otherwise("Enterprise"))\n\n    df_cleaned.write.mode("overwrite").option("header", "true").csv(f"{SILVER_PATH}/orders/orders_cleaned_pyspark.csv")\n    print("✅ Orders cleaned and saved.")\nexcept Exception as e:\n    print("Error cleaning orders:", e)\n    raise\nfinally:\n    spark.stop()\nPY']
