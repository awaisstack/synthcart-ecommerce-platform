[2025-10-22T12:18:13.057+0000] {subprocess.py:75} INFO - Running command: ['/usr/bin/bash', '-c', '\necho "== Clean customer data =="\npython3 - <<\'PY\'\n\nimport os\nfrom pyspark.sql import SparkSession, functions as F\nfrom pyspark.sql.types import StringType, FloatType\n\n# set credentials and local ip inside runtime process\nos.environ[\'AWS_ACCESS_KEY_ID\'] = \'minioadmin\'\nos.environ[\'AWS_SECRET_ACCESS_KEY\'] = \'minioadmin\'\nos.environ[\'SPARK_LOCAL_IP\'] = \'127.0.0.1\'\n\n# create spark session (packages used to access s3a and aws jars)\nspark = SparkSession.builder \\\n    .appName("SilverLayerProcessing") \\\n    .config("spark.hadoop.fs.s3a.endpoint", "http://minio:9000") \\\n    .config("spark.hadoop.fs.s3a.access.key", "minioadmin") \\\n    .config("spark.hadoop.fs.s3a.secret.key", "minioadmin") \\\n    .config("spark.hadoop.fs.s3a.impl", "org.apache.hadoop.fs.s3a.S3AFileSystem") \\\n    .config("spark.jars.packages", "org.apache.hadoop:hadoop-aws:3.3.4,com.amazonaws:aws-java-sdk-s3:1.12.570") \\\n    .getOrCreate()\n\nfrom minio import Minio\nclient = Minio("minio:9000", access_key="minioadmin", secret_key="minioadmin", secure=False)\n\n# ensure buckets exist (idempotent)\nfor b in ["bronze", "silver"]:\n    try:\n        if not client.bucket_exists(b):\n            client.make_bucket(b)\n    except Exception as e:\n        # keep going; bucket checks often fail if MinIO not yet fully ready — error will surface when reading\n        print("minio bucket check:", e)\n\n# define s3a paths\nBRONZE_PATH = "s3a://bronze"\nSILVER_PATH = "s3a://silver"\n\ntry:\n    df = spark.read.option("header", "true").csv(f"{BRONZE_PATH}/customers/customers.csv")\n    print("Raw customers rows:", df.count())\n\n    df_cleaned = df.dropDuplicates(["id"])         .na.drop(subset=["id", "email"])         .withColumn("firstName", F.coalesce(F.col("firstName"), F.lit("Unknown")))         .withColumn("lastName", F.coalesce(F.col("lastName"), F.lit("Unknown")))         .withColumn("phone", F.coalesce(F.col("phone"), F.lit("Not Provided")))         .withColumn("email", F.lower(F.trim(F.col("email"))))         .withColumn("phone", F.regexp_replace(F.col("phone").cast(StringType()), r"[^0-9+]", ""))         .withColumn("email_valid", F.col("email").rlike(r".+@.+\\..+"))         .withColumn("phone_valid", F.length(F.col("phone")) >= 10)\n\n    df_cleaned.write.mode("overwrite").option("header", "true").csv(f"{SILVER_PATH}/customers/customers_cleaned_pyspark.csv")\n    print("✅ Customers cleaned and saved.")\nexcept Exception as e:\n    print("Error cleaning customers:", e)\n    raise\nfinally:\n    spark.stop()\nPY']
