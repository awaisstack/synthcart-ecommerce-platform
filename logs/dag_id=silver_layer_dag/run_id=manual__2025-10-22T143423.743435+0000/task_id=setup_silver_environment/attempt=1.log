[2025-10-22T14:34:25.308+0000] {subprocess.py:75} INFO - Running command: ['/usr/bin/bash', '-c', '\necho "== Silver env check =="\npython3 - <<\'PY\'\n\nimport os, re, io, json\nfrom datetime import datetime\nfrom pyspark.sql import SparkSession, functions as F\nfrom pyspark.sql.types import StringType, FloatType\nfrom minio import Minio\n\nos.environ[\'AWS_ACCESS_KEY_ID\'] = \'minioadmin\'\nos.environ[\'AWS_SECRET_ACCESS_KEY\'] = \'minioadmin\'\nos.environ[\'SPARK_LOCAL_IP\'] = \'127.0.0.1\'\n\nspark = SparkSession.builder \\\n    .appName("SilverLayerProcessing") \\\n    .config("spark.hadoop.fs.s3a.endpoint", "http://minio:9000") \\\n    .config("spark.hadoop.fs.s3a.access.key", "minioadmin") \\\n    .config("spark.hadoop.fs.s3a.secret.key", "minioadmin") \\\n    .config("spark.hadoop.fs.s3a.impl", "org.apache.hadoop.fs.s3a.S3AFileSystem") \\\n    .config("spark.hadoop.fs.s3a.path.style.access", "true") \\\n    .config("spark.jars.packages", "org.apache.hadoop:hadoop-aws:3.3.4,com.amazonaws:aws-java-sdk-bundle:1.12.262") \\\n    .getOrCreate()\n\nclient = Minio("minio:9000", access_key="minioadmin", secret_key="minioadmin", secure=False)\n\nBRONZE_BUCKET = "bronze"\nBRONZE_PREFIXES = ["kaggle_data", "api_data"]\nSILVER_PATH = "s3a://silver"\n\ndef list_first_level_subfolders(prefix_root):\n    found = set()\n    try:\n        for obj in client.list_objects(BRONZE_BUCKET, prefix=f"{prefix_root}/", recursive=True):\n            parts = obj.object_name.split("/")\n            if len(parts) >= 2:\n                found.add(parts[1])\n    except Exception as e:\n        print("Error listing objects for", prefix_root, e)\n    return sorted([f for f in found if re.match(r"^[0-9]{8}_[0-9]{6}$", f)])\n\ndef get_latest_timestamp_for_prefix(prefix_root):\n    subs = list_first_level_subfolders(prefix_root)\n    return subs[-1] if subs else None\n\ndef object_exists_in_folder(prefix_root, ts_folder, candidate_names):\n    if not ts_folder:\n        return None\n    folder_prefix = f"{prefix_root}/{ts_folder}/"\n    try:\n        for obj in client.list_objects(BRONZE_BUCKET, prefix=folder_prefix, recursive=True):\n            name = obj.object_name.split("/")[-1].lower()\n            for cand in candidate_names:\n                if cand.lower() in name:\n                    return obj.object_name\n    except Exception as e:\n        print("Error checking objects in", folder_prefix, e)\n    return None\n\ndef spark_read_by_key(bucket, key):\n    path = f"s3a://{bucket}/{key}"\n    if key.lower().endswith(".csv"):\n        return spark.read.option("header", "true").option("inferSchema", "true").csv(path)\n    elif key.lower().endswith(".json"):\n        return spark.read.option("multiLine", "true").json(path)\n    else:\n        return spark.read.option("header", "true").option("inferSchema", "true").csv(path)\n\nprint("✅ Runtime libraries OK and MinIO connected.")\nspark.stop()\nPY']
